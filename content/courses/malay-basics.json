            {
              "id": "ms-u1-l4-s6",
              "kind": "listen",
              "text": "Listen and pick what you hear.",
              "say": "Apa khabar?",
              "options": [
                {
                  "id": "a",
                  "text": "Apa khabar?"
                },
                {
                  "id": "b",
                  "text": "Khabar baik"
                },
                {
                  "id": "c",
                  "text": "Terima kasih"
                }
              ],
              "answer": "a"
            },
            {
              "id": "ms-u1-l4-s7",
              "kind": "type",
              "text": "Type it in Malay.",
              "prompt": "How are you?",
              "accept": [
                "apa khabar"
              ],
              "explanation": "How are you? = Apa khabar?"
            }
          ]
        }
      ]
    },
