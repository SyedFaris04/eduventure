              "answer": [
                "Selamat",
                "pagi,",
                "cikgu!"
              ],
              "explanation": "Cikgu = teacher. Malaysian students greet their teacher this way every morning."
            },
            {
              "id": "ms-u1-l4-s5",
              "kind": "gap",
              "text": "Fill the gap.",
              "sentence": "Selamat ___, cikgu! 🌅",
              "options": [
                {
                  "id": "a",
                  "text": "pagi"
                },
                {
                  "id": "b",
                  "text": "malam"
                },
                {
                  "id": "c",
                  "text": "tinggal"
                }
              ],
              "answer": "a",
              "explanation": "The sun is rising, so it is pagi (morning)."
