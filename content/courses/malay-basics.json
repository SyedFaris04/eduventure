              "meaning": "one",
              "emoji": "1️⃣"
            },
            {
              "id": "ms-u1-l3-s2",
              "kind": "card",
              "text": "New word",
              "word": "dua",
              "meaning": "two",
              "emoji": "2️⃣"
            },
            {
              "id": "ms-u1-l3-s3",
              "kind": "card",
              "text": "New word",
              "word": "tiga",
              "meaning": "three",
              "emoji": "3️⃣"
            },
            {
              "id": "ms-u1-l3-s4",
              "kind": "match",
              "text": "Match the pairs.",
              "pairs": [
                [
                  "empat",
                  "four"
                ],
                [
                  "lima",
                  "five"
                ],
                [
                  "enam",
                  "six"
                ],
                [
                  "tujuh",
                  "seven"
                ]
              ]
            },
            {
              "id": "ms-u1-l3-s5",
              "kind": "pick",
              "text": "How many? (Berapa?)",
              "prompt": "🍎🍎🍎",
              "options": [
                {
                  "id": "a",
                  "text": "tiga"
                },
                {
                  "id": "b",
                  "text": "dua"
                },
                {
                  "id": "c",
                  "text": "lima"
                }
              ],
              "answer": "a",
              "explanation": "Tiga = three."
            },
            {
              "id": "ms-u1-l3-s6",
              "kind": "gap",
              "text": "Fill the gap.",
              "sentence": "Saya ada ___ kucing. 🐱🐱",
              "options": [
                {
                  "id": "a",
                  "text": "dua"
                },
                {
                  "id": "b",
                  "text": "tiga"
                },
                {
                  "id": "c",
                  "text": "satu"
                }
              ],
              "answer": "a",
              "explanation": "Dua = two. Saya ada dua kucing = I have two cats."
            },
            {
              "id": "ms-u1-l3-s7",
              "kind": "type",
              "text": "Type it in Malay.",
              "prompt": "ten",
              "accept": [
                "sepuluh",
                "10"
              ],
              "explanation": "Ten = sepuluh."
            }
          ]
        },
        {
          "id": "ms-u1-l4",
          "version": 1,
          "status": "in_review",
          "title": "Apa khabar?",
          "objective": "Ask and answer \"How are you?\".",
          "steps": [
            {
              "id": "ms-u1-l4-s1",
              "kind": "card",
              "text": "New word",
              "word": "Apa khabar?",
              "meaning": "How are you?",
              "emoji": "🤗"
            },
            {
              "id": "ms-u1-l4-s2",
              "kind": "card",
              "text": "New word",
              "word": "Khabar baik",
              "meaning": "I am fine",
              "emoji": "😊"
            },
            {
              "id": "ms-u1-l4-s3",
              "kind": "pick",
              "text": "Pick the best reply.",
              "prompt": "\"Apa khabar?\"",
              "options": [
                {
                  "id": "a",
                  "text": "Khabar baik, terima kasih."
                },
                {
                  "id": "b",
                  "text": "Nama saya Ali."
                },
                {
                  "id": "c",
                  "text": "Selamat malam."
                }
              ],
              "answer": "a",
              "explanation": "Apa khabar? is answered with Khabar baik (I am fine)."
