      "title": "Salam & perkenalan",
      "lessons": [
        {
          "id": "ms-u1-l1",
          "version": 1,
          "status": "in_review",
          "title": "Salam",
          "objective": "Greet people in Malay.",
          "steps": [
            {
              "id": "ms-u1-l1-s1",
              "kind": "card",
              "text": "New word",
              "word": "Selamat pagi",
              "meaning": "Good morning",
              "emoji": "🌅"
            },
            {
              "id": "ms-u1-l1-s2",
              "kind": "card",
              "text": "New word",
              "word": "Terima kasih",
              "meaning": "Thank you",
              "emoji": "🙏"
            },
            {
              "id": "ms-u1-l1-s3",
              "kind": "pick",
              "text": "Pick the meaning.",
              "prompt": "How do you say \"Thank you\" in Malay?",
              "options": [
                {
                  "id": "a",
                  "text": "Terima kasih"
                },
                {
                  "id": "b",
                  "text": "Selamat pagi"
                },
                {
                  "id": "c",
                  "text": "Sama-sama"
                }
              ],
              "answer": "a",
              "explanation": "Terima kasih = Thank you. Sama-sama = You are welcome."
            },
            {
              "id": "ms-u1-l1-s4",
              "kind": "card",
              "text": "New word",
              "word": "Selamat malam",
              "meaning": "Good night",
              "emoji": "🌙"
            },
            {
              "id": "ms-u1-l1-s5",
              "kind": "match",
              "text": "Match the pairs.",
              "pairs": [
                [
                  "Helo",
                  "Hello"
                ],
                [
                  "Selamat pagi",
                  "Good morning"
                ],
                [
                  "Terima kasih",
                  "Thank you"
                ],
                [
                  "Selamat tinggal",
                  "Goodbye"
                ]
              ]
            },
            {
              "id": "ms-u1-l1-s6",
              "kind": "listen",
              "text": "Listen and pick what you hear.",
              "say": "Selamat pagi",
              "options": [
                {
                  "id": "a",
                  "text": "Selamat pagi"
                },
                {
                  "id": "b",
                  "text": "Selamat malam"
                },
                {
                  "id": "c",
                  "text": "Selamat tinggal"
                }
              ],
              "answer": "a"
            },
            {
              "id": "ms-u1-l1-s7",
              "kind": "type",
              "text": "Type it in Malay.",
              "prompt": "Thank you",
              "accept": [
                "terima kasih"
              ],
              "explanation": "Thank you = Terima kasih."
            }
          ]
        },
        {
          "id": "ms-u1-l2",
          "version": 1,
          "status": "in_review",
          "title": "Perkenalan",
          "objective": "Introduce yourself in Malay.",
          "steps": [
            {
              "id": "ms-u1-l2-s1",
              "kind": "card",
              "text": "New word",
              "word": "Nama saya…",
              "meaning": "My name is…",
              "emoji": "🏷️"
            },
            {
              "id": "ms-u1-l2-s2",
              "kind": "card",
              "text": "New word",
              "word": "saya",
              "meaning": "I / me",
              "emoji": "🙋"
            },
            {
              "id": "ms-u1-l2-s3",
              "kind": "card",
              "text": "New word",
              "word": "kawan",
              "meaning": "friend",
              "emoji": "🧑‍🤝‍🧑"
            },
            {
              "id": "ms-u1-l2-s4",
              "kind": "build",
              "text": "Build the sentence in Malay.",
              "prompt": "My name is Adam.",
              "tiles": [
                "Nama",
                "saya",
                "Adam.",
                "awak",
                "kawan"
              ],
              "answer": [
                "Nama",
                "saya",
                "Adam."
              ],
              "explanation": "In Malay the word order is \"Nama saya Adam\" (name my Adam)."
            },
            {
              "id": "ms-u1-l2-s5",
              "kind": "gap",
              "text": "Fill the gap.",
              "sentence": "___ saya Mei.",
              "options": [
                {
                  "id": "a",
                  "text": "Nama"
                },
                {
                  "id": "b",
                  "text": "Makan"
                },
                {
                  "id": "c",
                  "text": "Rumah"
                }
              ],
              "answer": "a",
              "explanation": "\"Nama saya Mei\" = My name is Mei."
            },
            {
              "id": "ms-u1-l2-s6",
              "kind": "pick",
              "text": "Pick the meaning.",
              "prompt": "\"Saya pelajar.\" means…",
              "options": [
                {
                  "id": "a",
                  "text": "I am a student."
                },
                {
                  "id": "b",
                  "text": "I am a teacher."
                },
                {
                  "id": "c",
                  "text": "I like rice."
                }
              ],
              "answer": "a",
              "explanation": "Pelajar = student."
            },
            {
              "id": "ms-u1-l2-s7",
              "kind": "type",
              "text": "Type it in Malay.",
              "prompt": "My name is Ali.",
              "accept": [
                "nama saya ali"
              ],
              "explanation": "My name is Ali = Nama saya Ali."
            }
          ]
        },
        {
          "id": "ms-u1-l3",
          "version": 1,
          "status": "in_review",
          "title": "Nombor",
