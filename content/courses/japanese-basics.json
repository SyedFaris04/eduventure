                {
                  "id": "b",
                  "text": "See you tomorrow"
                },
                {
                  "id": "c",
                  "text": "Excuse me"
                }
              ],
              "answer": "a",
              "explanation": "はじめまして (hajimemashite) = Nice to meet you."
