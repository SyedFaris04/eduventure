# Copy this file to .env.local and fill in the values from
# Supabase dashboard > Project Settings > API (or "Connect").
# Only the PUBLIC key goes here. Never put the service_role / secret key in any VITE_ variable:
# everything prefixed VITE_ is shipped to the browser.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_or_legacy_anon_key

# Optional: the multiplayer room server (server/rooms). Unset = multiplayer off.
# Local: ws://localhost:8787   Online: wss://eduventure-rooms.<account>.workers.dev
# VITE_ROOMS_URL=
